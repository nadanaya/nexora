  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Reason",
            "default": ""
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "source_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Kind"
          },
          "agency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agency"
          },
          "account": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Account"
          },
          "holder": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Holder"
          },
          "evidence_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Id"
          },
          "planned_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned Date"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "revision"
        ],
        "title": "Action"
      },
      "Change": {
        "properties": {
          "agency": {
            "type": "string",
            "title": "Agency"
          },
          "patch": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Patch"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Reason"
          },
          "source_kind": {
            "type": "string",
            "title": "Source Kind"
          },
          "effective_at": {
            "type": "string",
            "title": "Effective At"
          },
          "base_version": {
            "type": "integer",
            "title": "Base Version"
          },
          "apply": {
            "type": "boolean",
            "title": "Apply",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agency",
          "patch",
          "reason",
          "source_kind",
          "effective_at",
          "base_version"
        ],
        "title": "Change"
      },
      "Correction": {
        "properties": {
          "amount": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Reason"
          },
          "source_kind": {
            "type": "string",
            "title": "Source Kind"
          },
          "base_version": {
            "type": "integer",
            "title": "Base Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount",
          "reason",
          "source_kind",
          "base_version"
        ],
        "title": "Correction"
      },
      "Files": {
        "properties": {
          "agencies": {
            "type": "string",
            "maxLength": 5000000,
            "title": "Agencies"
          },
          "rebates": {
            "type": "string",
            "maxLength": 5000000,
            "title": "Rebates"
          },
          "deposits": {
            "type": "string",
            "maxLength": 5000000,
            "title": "Deposits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agencies",
          "rebates",
          "deposits"
        ],
        "title": "Files"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Member": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "User Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "role"
        ],
        "title": "Member"
      },
      "NewCase": {
        "properties": {
          "agency": {
            "type": "string",
            "maxLength": 100,
            "title": "Agency"
          },
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Month"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agency",
          "month"
        ],
        "title": "NewCase"
      },
      "Resolution": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "Resolution"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
